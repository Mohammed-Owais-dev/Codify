{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/courses",
      "destination": "/src/pages/courses.html"
    },
    {
      "source": "/courses/:course",
      "destination": "/src/pages/courses/course-index.html"
    },
    {
      "source": "/courses/:course/:lesson",
      "destination": "/src/pages/courses/course-lesson.html"
    },
    {
      "source": "/exam",
      "destination": "/src/pages/courses/exam.html"
    },
    {
      "source": "/certificate",
      "destination": "/src/pages/certificate.html"
    },
    {
      "source": "/contact",
      "destination": "/src/pages/contact.html"
    },
    {
      "source": "/login",
      "destination": "/src/auth/login.html"
    },
    {
      "source": "/signup",
      "destination": "/src/auth/signup.html"
    }
  ]
}