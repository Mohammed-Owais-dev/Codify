{
  "rewrites": [
    {
      "source": "/courses",
      "destination": "/src/pages/courses.html"
    },
    {
      "source": "/exam",
      "destination": "/src/pages/exam.html"
    },
    {
      "source": "/certificate",
      "destination": "/src/pages/certificate.html"
    },
    {
      "source": "/contact",
      "destination": "/src/pages/contact.html"
    },
    {
      "source": "/about",
      "destination": "/src/pages/about.html"
    },
    {
      "source": "/privacy",
      "destination": "/src/pages/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/src/pages/terms.html"
    },
    {
      "source": "/quick-notes",
      "destination": "/src/pages/quick-notes.html"
    },
    {
      "source": "/quick-notes/:language/:chapter",
      "destination": "/src/pages/quick-notes/quick-notes-lesson.html"
    },
    {
      "source": "/quick-notes/:language",
      "destination": "/src/pages/quick-notes/quick-notes-index.html"
    },
    {
      "source": "/login",
      "destination": "/src/auth/login.html"
    },
    {
      "source": "/signup",
      "destination": "/src/auth/signup.html"
    },
    {
      "source": "/profile",
      "destination": "/src/pages/account/profile.html"
    },
    {
      "source": "/account-security",
      "destination": "/src/pages/account/account-security.html"
    },
    {
      "source": "/activity",
      "destination": "/src/pages/account/activity.html"
    },
    {
      "source": "/admin",
      "destination": "/src/pages/admin.html"
    },
    {
      "source": "/exam/:course",
      "destination": "/src/pages/exams/exam.html"
    },
    {
      "source": "/courses/:course/enroll",
      "destination": "/src/pages/courses/course-enroll.html"
    },
    {
      "source": "/courses/:course",
      "destination": "/src/pages/courses/course-index.html"
    },
    {
      "source": "/courses/:course/:lesson",
      "destination": "/src/pages/courses/course-lesson.html"
    }
  ],
  "headers": [
    {
      "source": "/(admin|profile|account-security|activity|login|signup)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/exam/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/courses/(.*)/enroll",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
