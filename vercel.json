{
  "rewrites": [
    {
      "source": "/courses",
      "destination": "/src/pages/courses.html"
    },
    {
      "source": "/exams",
      "destination": "/src/pages/exams.html"
    },
    {
      "source": "/certificate",
      "destination": "/src/pages/certificate.html"
    },
    {
      "source": "/contact",
      "destination": "/src/pages/contact.html"
    },
    {
      "source": "/quick-notes",
      "destination": "/src/pages/quick-notes.html"
    },
    {
      "source": "/login",
      "destination": "/src/auth/login.html"
    },
    {
      "source": "/signup",
      "destination": "/src/auth/signup.html"
    },
    {
      "source": "/profile",
      "destination": "/src/pages/account/profile.html"
    },
    {
      "source": "/account-security",
      "destination": "/src/pages/account/account-security.html"
    },
    {
      "source": "/activity",
      "destination": "/src/pages/account/activity.html"
    },
    {
      "source": "/courses/:course/enroll",
      "destination": "/src/pages/courses/course-enroll.html"
    },
    {
      "source": "/courses/:course",
      "destination": "/src/pages/courses/course-index.html"
    },
    {
      "source": "/courses/:course/:lesson",
      "destination": "/src/pages/courses/course-lesson.html"
    },
    {
      "source": "/(.*)",
      "destination": "/src/pages/404.html"
    }
  ]
}